{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core defaults, window dragging and the Windows caption buttons (minimise, maximise, close) for data-tauri-drag-region, native dialogs, Kiln storage and agent bridge commands.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    "dialog:default",
    "allow-list-files",
    "allow-load-file",
    "allow-save-file",
    "allow-delete-file",
    "allow-reveal-files-folder",
    "allow-export-to-folder",
    "allow-agent-register-tools",
    "allow-agent-respond",
    "allow-agent-status",
    "allow-agent-cli-detect",
    "allow-agent-cli-run",
    "allow-agent-cli-cancel",
    "allow-agent-cli-connect",
    "allow-agent-cli-connect-snippets",
    "allow-clipboard-read-text",
    "allow-list-projects",
    "allow-create-project",
    "allow-update-project",
    "allow-remove-project",
    "allow-move-file",
    "allow-list-trash",
    "allow-restore-trash",
    "allow-purge-trash",
    "allow-agent-cli-models"
  ]
}
