{
  "name": "kiln",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "tauri": "tauri",
    "desktop:dev": "PATH=\"$HOME/.cargo/bin:$PATH\" tauri dev",
    "desktop:build": "PATH=\"$HOME/.cargo/bin:$PATH\" tauri build",
    "release:mac": "bash scripts/release-mac.sh",
    "tauri:build:mac": "tauri build --target universal-apple-darwin --bundles app,dmg",
    "tauri:build:win": "tauri build --bundles nsis,msi",
    "tauri:build:linux": "tauri build --bundles deb,appimage,rpm"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "immer": "^11.2.10",
    "lucide-react": "^1.74.0",
    "nanoid": "^6.0.2",
    "openai": "^7.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
